<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BanglaHost.App.Views.AiAssistantPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="28,24,28,28" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource BhGradientBrush}">
                    <FontIcon Glyph="&#xE99A;" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="AI Assistant" Style="{StaticResource PageTitleStyle}" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="Ask about your stack. Runs locally through Ollama — no data leaves your machine."
                       Style="{StaticResource PageSubtitleStyle}" Margin="48,0,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" x:Name="SetupCard" Visibility="Collapsed" Style="{StaticResource PremiumCard}">
            <StackPanel Spacing="10">
                <TextBlock Text="Ollama is not running" Style="{StaticResource CardTitleStyle}"/>
                <TextBlock Text="To use the local AI Assistant, you need to install and start Ollama." FontSize="13" Opacity="0.7"/>
                <Button Content="Install Ollama" Click="InstallOllama_Click" Style="{StaticResource PillButton}" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2" x:Name="ChatScroll" Padding="0,0,12,0">
            <StackPanel x:Name="ChatList" Spacing="14">
                <Border CornerRadius="14" Padding="16" HorizontalAlignment="Left" MaxWidth="520">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#0C6366F1" Offset="0"/>
                            <GradientStop Color="#0806B6D4" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Text="Hello! I'm your BanglaHost AI Assistant. I can help you manage your local web server and sites. How can I help you today?" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="3" ColumnSpacing="10" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="Input" PlaceholderText="Ask a question..." KeyUp="Input_KeyUp" CornerRadius="20" Padding="16,10"/>
            <Button Grid.Column="1" Click="Send_Click" CornerRadius="20" Width="44" Height="44">
                <Button.Background>
                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                        <GradientStop Color="#FF6366F1" Offset="0"/>
                        <GradientStop Color="#FF06B6D4" Offset="1"/>
                    </LinearGradientBrush>
                </Button.Background>
                <FontIcon Glyph="&#xE724;" FontSize="15" Foreground="White"/>
            </Button>
        </Grid>
    </Grid>
</Page>
