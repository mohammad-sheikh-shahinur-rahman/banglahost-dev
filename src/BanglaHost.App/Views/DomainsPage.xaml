<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BanglaHost.App.Views.DomainsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:BanglaHost.Core">

    <ScrollViewer>
        <StackPanel Padding="28,24,28,28" Spacing="18">
            <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border Width="36" Height="36" CornerRadius="10">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#FFF59E0B" Offset="0"/>
                                <GradientStop Color="#FFEAB308" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <FontIcon Glyph="&#xE774;" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Domains &amp; DNS" Style="{StaticResource PageTitleStyle}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Manage local HOSTS file routing, check DNS propagation, and update Cloudflare DNS."
                           Style="{StaticResource PageSubtitleStyle}" Margin="48,0,0,0"/>
            </StackPanel>

            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column -->
                <StackPanel Grid.Column="0" Spacing="16">
                    <Border Style="{StaticResource PremiumCard}">
                        <StackPanel Spacing="14">
                            <TextBlock Text="Local HOSTS Entries" Style="{StaticResource CardTitleStyle}"/>
                            <TextBlock Text="Requires UAC elevation to update." FontSize="13" Opacity="0.7"/>
                            
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="HostIpBox" Grid.Column="0" Text="127.0.0.1" PlaceholderText="IP Address"/>
                                <TextBox x:Name="HostDomainBox" Grid.Column="1" PlaceholderText="domain.test"/>
                                <Button x:Name="AddHostBtn" Grid.Column="2" Content="Add" Click="AddHostBtn_Click" Style="{StaticResource PillButton}" Background="{StaticResource BhBrandBrush}" Foreground="White"/>
                            </Grid>
                            <TextBlock x:Name="HostOpStatus" Style="{StaticResource LabelStyle}"/>

                            <Border Style="{StaticResource ListCard}" MinHeight="200" Margin="0,8,0,0">
                                <ListView x:Name="HostsList">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="core:HostEntry">
                                            <Grid Padding="14,10" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="3">
                                                    <TextBlock Text="{x:Bind Domain}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{x:Bind IpAddress}" Style="{StaticResource LabelStyle}" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="Remove" Click="RemoveHostBtn_Click" Tag="{x:Bind Domain}" CornerRadius="16" Foreground="{StaticResource BhErrorBrush}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right Column -->
                <StackPanel Grid.Column="1" Spacing="16">
                    <Border Style="{StaticResource PremiumCard}">
                        <StackPanel Spacing="14">
                            <TextBlock Text="DNS Checker" Style="{StaticResource CardTitleStyle}"/>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="CheckDomainBox" Grid.Column="0" PlaceholderText="example.com"/>
                                <Button x:Name="CheckDnsBtn" Grid.Column="1" Content="Check" Click="CheckDnsBtn_Click" Style="{StaticResource PillButton}"/>
                            </Grid>
                            <TextBlock x:Name="DnsResult" Style="{StaticResource LabelStyle}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PremiumCard}">
                        <StackPanel Spacing="14">
                            <TextBlock Text="Cloudflare Auto-DNS" Style="{StaticResource CardTitleStyle}"/>
                            
                            <StackPanel Spacing="8">
                                <TextBlock Text="API Token" FontSize="12" Opacity="0.7"/>
                                <TextBox x:Name="CfTokenBox" PlaceholderText="Requires DNS Edit permissions"/>
                            </StackPanel>
                            <StackPanel Spacing="8">
                                <TextBlock Text="Zone ID" FontSize="12" Opacity="0.7"/>
                                <TextBox x:Name="CfZoneBox"/>
                            </StackPanel>
                            <StackPanel Spacing="8">
                                <TextBlock Text="Domain Name" FontSize="12" Opacity="0.7"/>
                                <TextBox x:Name="CfDomainBox"/>
                            </StackPanel>
                            <StackPanel Spacing="8">
                                <TextBlock Text="Target IP" FontSize="12" Opacity="0.7"/>
                                <TextBox x:Name="CfIpBox"/>
                            </StackPanel>

                            <Button x:Name="UpdateCfBtn" Content="Update DNS Record" Click="UpdateCfBtn_Click" Style="{StaticResource PillButton}" HorizontalAlignment="Stretch" Margin="0,8,0,0"/>
                            <TextBlock x:Name="CfResult" Style="{StaticResource LabelStyle}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
