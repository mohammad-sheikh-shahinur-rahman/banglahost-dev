<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BanglaHost.App.Views.DatabaseExplorerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BanglaHost.App.Views">

    <Grid Padding="28,24,28,28" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource BhGradientBrush}">
                    <FontIcon Glyph="&#xE8D5;" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="SQL Studio" Style="{StaticResource PageTitleStyle}" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="Browse local MySQL databases, tables, and rows directly within BanglaHost."
                       Style="{StaticResource PageSubtitleStyle}" Margin="48,0,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Databases List -->
            <Border Grid.Column="0" Style="{StaticResource PremiumCard}" Padding="10">
                <StackPanel>
                    <TextBlock Text="Databases" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <ListView x:Name="DbList" SelectionChanged="DbList_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <StackPanel Orientation="Horizontal" Spacing="8" Padding="0,6">
                                    <FontIcon Glyph="&#xE8D5;" FontSize="14" Foreground="#FF3B82F6"/>
                                    <TextBlock Text="{x:Bind}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <!-- Tables List -->
            <Border Grid.Column="1" Style="{StaticResource PremiumCard}" Padding="10">
                <StackPanel>
                    <TextBlock Text="Tables" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <ListView x:Name="TableList" SelectionChanged="TableList_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <StackPanel Orientation="Horizontal" Spacing="8" Padding="0,6">
                                    <FontIcon Glyph="&#xE821;" FontSize="14" Foreground="#FF10B981"/>
                                    <TextBlock Text="{x:Bind}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <!-- Data / Results -->
            <Border Grid.Column="2" Style="{StaticResource PremiumCard}" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
                        <TextBox x:Name="QueryBox" PlaceholderText="SELECT * FROM table LIMIT 100" Width="400"/>
                        <Button Content="Execute" Click="Execute_Click" Style="{StaticResource AccentButtonStyle}"/>
                    </StackPanel>

                    <!-- The primitive DataGrid via a ScrollViewer + TextBlock for now -->
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <TextBox x:Name="ResultBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas" BorderThickness="0"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
