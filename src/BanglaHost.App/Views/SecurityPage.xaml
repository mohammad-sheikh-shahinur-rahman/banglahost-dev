<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BanglaHost.App.Views.SecurityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:BanglaHost.Core">

    <ScrollViewer>
        <StackPanel Padding="28,24,28,28" Spacing="18">
            <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border Width="36" Height="36" CornerRadius="10">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#FFEF4444" Offset="0"/>
                                <GradientStop Color="#FFF87171" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <FontIcon Glyph="&#xEA18;" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Security &amp; WAF" Style="{StaticResource PageTitleStyle}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Scan for vulnerabilities and manage the Web Application Firewall."
                           Style="{StaticResource PageSubtitleStyle}" Margin="48,0,0,0"/>
            </StackPanel>

            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="16">
                    <Border Style="{StaticResource PremiumCard}">
                        <StackPanel Spacing="14">
                            <TextBlock Text="Malware &amp; Vulnerability Scanner" Style="{StaticResource CardTitleStyle}"/>
                            <TextBlock Text="Scans your project files for known backdoors, web shells, and dangerous patterns." FontSize="13" Opacity="0.7" TextWrapping="Wrap"/>
                            
                            <StackPanel Spacing="8">
                                <TextBlock Text="Target Directory" FontSize="12" Opacity="0.7"/>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="ScanDirBox" Grid.Column="0"/>
                                    <Button Content="Browse..." Grid.Column="1" Click="BrowseScanDir_Click"/>
                                </Grid>
                            </StackPanel>

                            <Button x:Name="ScanBtn" Content="Start Security Scan" Click="ScanBtn_Click" 
                                    Style="{StaticResource PillButton}" Background="{StaticResource BhBrandBrush}" Foreground="White"
                                    HorizontalAlignment="Stretch" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PremiumCard}">
                        <StackPanel Spacing="14">
                            <TextBlock Text="Web Application Firewall (WAF)" Style="{StaticResource CardTitleStyle}"/>
                            <TextBlock Text="Block common SQL injection, XSS, and malicious payloads at the web server level." FontSize="13" Opacity="0.7" TextWrapping="Wrap"/>
                            
                            <ToggleSwitch x:Name="WafToggle" Header="ModSecurity / WAF Engine" Toggled="WafToggle_Toggled"/>
                            <TextBlock x:Name="WafStatus" Style="{StaticResource LabelStyle}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="12">
                    <TextBlock Text="Scan Results" FontWeight="SemiBold"/>
                    <Border Style="{StaticResource ListCard}" MinHeight="400">
                        <Grid>
                            <TextBlock x:Name="EmptyScanText" Text="No scan performed or no issues found." Opacity="0.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <ListView x:Name="ScanResultsList" Visibility="Collapsed">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="core:SecurityScanResult">
                                        <Grid Padding="14,10" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                                            <StackPanel Spacing="3">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{x:Bind ThreatType}" FontWeight="SemiBold" Foreground="{StaticResource BhErrorBrush}"/>
                                                    <Border Background="{StaticResource BhErrorBrush}" CornerRadius="4" Padding="4,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind Severity}" FontSize="10" Foreground="White" FontWeight="Bold"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{x:Bind FilePath}" FontSize="12" Opacity="0.8" TextWrapping="Wrap"/>
                                                <TextBlock Text="{x:Bind Description}" Style="{StaticResource LabelStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
