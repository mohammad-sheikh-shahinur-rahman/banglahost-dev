<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BanglaHost.App.Views.DatabasesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BanglaHost.App.Views">

    <ScrollViewer>
    <StackPanel Padding="28,24,28,28" Spacing="18">
        <!-- ════ Header ════ -->
        <StackPanel Orientation="Horizontal" Spacing="12">
            <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource BhDbAccent}">
                <FontIcon Glyph="&#xEE94;" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="Databases" Style="{StaticResource PageTitleStyle}" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- ════ Servers ════ -->
        <Border Style="{StaticResource PremiumCard}">
            <StackPanel Spacing="14">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock x:Name="DbEngineLabel" Text="MySQL / MariaDB" Width="140" VerticalAlignment="Center" Opacity="0.7"/>
                    <Button x:Name="StartDbBtn" Content="Start" Click="StartDb_Click" Style="{StaticResource PillButton}"/>
                    <Button x:Name="StopDbBtn"  Content="Stop"  Click="StopDb_Click" CornerRadius="20"/>
                    <Button Content="Root password…" Click="RootPw_Click" CornerRadius="16"/>
                    <TextBlock x:Name="RootPwStatus" VerticalAlignment="Center" Style="{StaticResource LabelStyle}"/>
                </StackPanel>
                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,2"/>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="PostgreSQL" Width="120" VerticalAlignment="Center" Opacity="0.7"/>
                    <Button x:Name="StartPgBtn" Content="Start" Click="StartPg_Click" CornerRadius="20"/>
                    <Button x:Name="StopPgBtn"  Content="Stop"  Click="StopPg_Click" CornerRadius="20"/>
                    <Button x:Name="InstallPgBtn" Content="Install PostgreSQL" Click="InstallPg_Click" CornerRadius="16"/>
                    <TextBlock x:Name="PgStatus" VerticalAlignment="Center" Style="{StaticResource LabelStyle}"/>
                    <ProgressRing x:Name="Busy" IsActive="False" Width="22" Height="22" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ════ Create ════ -->
        <Border Style="{StaticResource PremiumCard}">
            <StackPanel Spacing="12">
                <TextBlock Text="Create a new database" Style="{StaticResource CardTitleStyle}"/>
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <ComboBox x:Name="EngineBox" Width="140" PlaceholderText="no engine running" SelectionChanged="Engine_Changed" CornerRadius="8"/>
                    <TextBox x:Name="NameBox" PlaceholderText="new database name" Width="200" CornerRadius="8"/>
                    <TextBox x:Name="PassBox" PlaceholderText="user password (MySQL, optional)" Width="200" CornerRadius="8"/>
                    <Button x:Name="GenBtn" Content="Generate" Click="GenPw_Click" CornerRadius="16"/>
                    <Button x:Name="CreateBtn" Content="Create" Click="Create_Click" Style="{StaticResource PillButton}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ════ Database list ════ -->
        <Border Style="{StaticResource ListCard}">
            <StackPanel>
                <Grid Padding="10,8" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="Show" VerticalAlignment="Center" Opacity="0.7"/>
                        <ComboBox x:Name="DbPageSizeBox" Width="80" SelectionChanged="DbPageSize_Changed" CornerRadius="8"/>
                    </StackPanel>
                    <TextBox Grid.Column="2" x:Name="DbSearchBox" PlaceholderText="search…" Width="220" TextChanged="DbSearch_Changed" CornerRadius="10"/>
                </Grid>
                <TextBlock x:Name="EmptyDbs" Text="No databases yet." Opacity="0.6" Padding="14" Visibility="Collapsed"/>
                <ItemsControl x:Name="DbList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:DbRow">
                            <Grid Padding="10,8" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xEE94;" FontSize="14" Opacity="0.5"/>
                                    <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </StackPanel>
                                <Border Grid.Column="1" VerticalAlignment="Center" CornerRadius="6" Padding="8,3" Margin="0,0,6,0"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                    <TextBlock Text="{x:Bind Engine}" FontSize="11" Opacity="0.8"/>
                                </Border>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                                    <Button Content="Password…" Tag="{x:Bind Name}" Click="DbPassword_Click" Visibility="{x:Bind MysqlVis}" CornerRadius="16"/>
                                    <Button Content="Drop" Tag="{x:Bind Key}" Click="Drop_Click" CornerRadius="16"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Grid x:Name="DbPager" Padding="10,10" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Button x:Name="DbPrevBtn" Click="DbPrev_Click" CornerRadius="20"><FontIcon Glyph="&#xE76B;" FontSize="12"/></Button>
                        <TextBlock x:Name="DbPageLabel" VerticalAlignment="Center" Opacity="0.8"/>
                        <Button x:Name="DbNextBtn" Click="DbNext_Click" CornerRadius="20"><FontIcon Glyph="&#xE76C;" FontSize="12"/></Button>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ════ DB tools ════ -->
        <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="DB tools:" VerticalAlignment="Center" Opacity="0.7"/>
            <Button Content="phpMyAdmin" Click="Pma_Click" CornerRadius="16"/>
            <Button Content="Adminer"    Click="Adminer_Click" CornerRadius="16"/>
            <Button Content="Mailpit"    Click="Mailpit_Click" CornerRadius="16"/>
        </StackPanel>
    </StackPanel>
    </ScrollViewer>
</Page>
