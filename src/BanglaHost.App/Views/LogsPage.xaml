<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BanglaHost.App.Views.LogsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="28,24,28,28" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Border Width="36" Height="36" CornerRadius="10">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                            <GradientStop Color="#FFEF4444" Offset="0"/>
                            <GradientStop Color="#FFF97316" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <FontIcon Glyph="&#xE9D9;" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Logs" Style="{StaticResource PageTitleStyle}" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="Choose &quot;All errors&quot; to see every error/warning from every service in one view."
                       Style="{StaticResource PageSubtitleStyle}" Margin="48,0,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource PremiumCard}">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <ComboBox x:Name="FilePicker" Width="300" SelectionChanged="File_Changed" CornerRadius="8"/>
                <CheckBox x:Name="ErrorsOnly" Content="Errors only" IsChecked="True" Checked="Filter_Toggled" Unchecked="Filter_Toggled"/>
                <TextBox x:Name="FilterBox" PlaceholderText="filter..." Width="180" TextChanged="Filter_TextChanged" CornerRadius="10"/>
                <Button Content="Refresh" Click="Refresh_Click" CornerRadius="16"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" CornerRadius="12" Padding="0"
                BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="#0A0E14">
            <ScrollViewer x:Name="Scroll" Padding="16">
                <TextBlock x:Name="LogText" FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap"
                           IsTextSelectionEnabled="True" Foreground="#FFE2E8F0"/>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
