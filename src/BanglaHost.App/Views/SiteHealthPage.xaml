<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BanglaHost.App.Views.SiteHealthPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="28,24,28,28" Spacing="18">
            <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border Width="36" Height="36" CornerRadius="10">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#FF14B8A6" Offset="0"/>
                                <GradientStop Color="#FF3B82F6" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <FontIcon Glyph="&#xE9A1;" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Site Health Check" Style="{StaticResource PageTitleStyle}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Run diagnostics to check for common issues, missing dependencies, or misconfigurations."
                           Style="{StaticResource PageSubtitleStyle}" Margin="48,0,0,0"/>
            </StackPanel>

            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="12">
                    <TextBlock Text="Select Site" FontWeight="SemiBold"/>
                    <Border Style="{StaticResource ListCard}" MinHeight="400">
                        <ListView x:Name="SiteList" SelectionChanged="SiteList_SelectionChanged">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Grid Padding="14,12" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                                        <TextBlock Text="{x:Bind}" FontWeight="SemiBold"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <TextBlock Text="Health Report" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button x:Name="RunBtn" Content="Run Diagnostics" Click="RunBtn_Click" Style="{StaticResource PillButton}" Background="{StaticResource BhBrandBrush}" Foreground="White" IsEnabled="False"/>
                    </StackPanel>
                    
                    <Border Style="{StaticResource PremiumCard}" MinHeight="400">
                        <StackPanel x:Name="ReportPanel" Spacing="14">
                            <TextBlock Text="Select a site to run health checks." Opacity="0.6" HorizontalAlignment="Center" Margin="0,40,0,0" x:Name="EmptyStateText"/>
                            
                            <!-- Will inject diagnostic results dynamically in code-behind -->
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
