<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BanglaHost.App.Views.GitPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="28,24,28,28" Spacing="18">
            <!-- ════ Header ════ -->
            <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border Width="36" Height="36" CornerRadius="10">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#FFF97316" Offset="0"/>
                                <GradientStop Color="#FFEF4444" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <FontIcon Glyph="&#xE8AD;" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Git" Style="{StaticResource PageTitleStyle}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Style="{StaticResource PageSubtitleStyle}" Text="Manage local repositories under your Sites folder and connect to GitHub." Margin="48,0,0,0"/>
            </StackPanel>

            <!-- ════ Actions ════ -->
            <Border Style="{StaticResource PremiumCard}">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBox x:Name="CloneUrl" PlaceholderText="git@github.com:user/repo.git  or  https://github.com/user/repo.git" Width="440" CornerRadius="8"/>
                        <Button x:Name="CloneBtn" Content="Clone" Click="Clone_Click" Style="{StaticResource PillButton}"/>
                        <Button Content="Refresh" Click="Refresh_Click" CornerRadius="16"/>
                        <ProgressRing x:Name="Busy" IsActive="False" Width="22" Height="22"/>
                    </StackPanel>
                    <TextBlock x:Name="ActionResult" Style="{StaticResource LabelStyle}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- ════ GitHub sign-in ════ -->
            <Border Style="{StaticResource PremiumCard}">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE774;" FontSize="16" Foreground="{StaticResource BhMutedBrush}"/>
                        <TextBlock Text="GitHub" Style="{StaticResource CardTitleStyle}"/>
                    </StackPanel>
                    <TextBlock x:Name="GhStatus" Opacity="0.7" FontSize="13" Text="Not signed in."/>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <PasswordBox x:Name="GhToken" Header="Personal access token" PlaceholderText="ghp_..." Width="360" CornerRadius="8"/>
                        <Button x:Name="SaveTokenBtn" Content="Save token" Click="SaveToken_Click" VerticalAlignment="Bottom" Style="{StaticResource PillButton}"/>
                        <Button x:Name="ClearTokenBtn" Content="Sign out" Click="ClearToken_Click" VerticalAlignment="Bottom" CornerRadius="16"/>
                    </StackPanel>
                    <TextBlock FontSize="12" Opacity="0.5" TextWrapping="Wrap"
                               Text="Create a token at https://github.com/settings/tokens (fine-grained). Grant it: Contents (read/write), Metadata (read), Pull requests (read/write), Issues (read/write). It's stored locally in your BanglaHost config folder; nothing is sent to Anthropic."/>
                </StackPanel>
            </Border>

            <!-- ════ Local repos ════ -->
            <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon Glyph="&#xE8AD;" FontSize="14" Foreground="{StaticResource BhInfoBrush}"/>
                <TextBlock Text="Local repositories" Style="{StaticResource SectionTitleStyle}"/>
            </StackPanel>
            <Border Style="{StaticResource ListCard}" MinHeight="80">
                <StackPanel>
                    <TextBlock x:Name="EmptyRepos" Text="No git repositories found under your Sites folder yet."
                               Opacity="0.6" Padding="14" Visibility="Collapsed"/>
                    <ListView x:Name="RepoList" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="14,10" BorderThickness="0,0,0,1"
                                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                      ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Status}" Style="{StaticResource LabelStyle}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                        <Button Content="Pull"   Click="Pull_Click"   DataContext="{Binding}" CornerRadius="16"/>
                                        <Button Content="Push"   Click="Push_Click"   DataContext="{Binding}" CornerRadius="16"/>
                                        <Button Content="Status" Click="Status_Click" DataContext="{Binding}" CornerRadius="16"/>
                                        <Button Content="Log"    Click="Log_Click"    DataContext="{Binding}" CornerRadius="16"/>
                                        <Button Content="Folder" Click="Folder_Click" DataContext="{Binding}" CornerRadius="16"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
