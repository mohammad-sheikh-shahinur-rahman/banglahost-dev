<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BanglaHost.App.Views.ServicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BanglaHost.App.Views">

    <ScrollViewer>
        <StackPanel Padding="28,24,28,28" Spacing="18">
            <!-- ════ Header ════ -->
            <Grid>
                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource BhGradientBrush}">
                            <FontIcon Glyph="&#xE912;" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Services" Style="{StaticResource PageTitleStyle}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Install downloads portable builds on demand into BanglaHost's own bin folder."
                               Style="{StaticResource PageSubtitleStyle}" Margin="48,0,0,0"/>
                </StackPanel>
                <ProgressRing x:Name="Busy" IsActive="False" Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <!-- ════ Operation banner ════ -->
            <Border x:Name="OpBanner" Visibility="Collapsed" CornerRadius="12" Padding="16" BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#146366F1" Offset="0"/>
                        <GradientStop Color="#0806B6D4" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel Spacing="8">
                    <Grid>
                        <TextBlock x:Name="OpName" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                            <TextBlock x:Name="OpPct" Opacity="0.7" VerticalAlignment="Center"/>
                            <Button x:Name="OpDismiss" Content="Dismiss" Click="OpDismiss_Click" Visibility="Collapsed" CornerRadius="16"/>
                        </StackPanel>
                    </Grid>
                    <ProgressBar x:Name="OpBar" Minimum="0" Maximum="100" CornerRadius="4"/>
                    <TextBlock x:Name="OpMsg" Style="{StaticResource LabelStyle}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- ════ Service groups ════ -->
            <ItemsControl x:Name="Groups">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:SvcGroup">
                        <Border CornerRadius="12" Padding="14" Margin="0,0,0,10" BorderThickness="1"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,2,0,8">
                                    <Border Width="4" Height="18" CornerRadius="2" Background="{StaticResource BhGradientVertical}"/>
                                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" Opacity="0.85"/>
                                </StackPanel>
                                <ItemsControl ItemsSource="{x:Bind Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="local:SvcRow">
                                            <Grid Padding="8,7" ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="14"/>
                                                    <ColumnDefinition Width="130"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Grid.Column="0" Width="10" Height="10" Fill="{x:Bind DotBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{x:Bind Key}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{x:Bind StatusText}" Style="{StaticResource LabelStyle}" VerticalAlignment="Center"/>
                                                <ToggleButton Grid.Column="3" Tag="{x:Bind Key}" IsChecked="{x:Bind AutoStart}" Click="AutoStar_Click"
                                                              ToolTipService.ToolTip="Start automatically" VerticalAlignment="Center" Padding="6"
                                                              Visibility="{x:Bind ManageVis}" CornerRadius="8">
                                                    <FontIcon Glyph="&#xE734;" FontSize="13"/>
                                                </ToggleButton>
                                                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6">
                                                    <Button Content="Install" Tag="{x:Bind Key}" Click="Install_Click" IsEnabled="{x:Bind NotInstalled}" CornerRadius="16"/>
                                                    <Button Content="Start"   Tag="{x:Bind Key}" Click="Start_Click"   IsEnabled="{x:Bind CanStart}" Visibility="{x:Bind ManageVis}" CornerRadius="16"/>
                                                    <Button Content="Stop"    Tag="{x:Bind Key}" Click="Stop_Click"    IsEnabled="{x:Bind Running}" Visibility="{x:Bind ManageVis}" CornerRadius="16"/>
                                                    <Button ToolTipService.ToolTip="More" IsEnabled="{x:Bind Installed}" CornerRadius="8">
                                                        <FontIcon Glyph="&#xE712;" FontSize="14"/>
                                                        <Button.Flyout>
                                                            <MenuFlyout>
                                                                <MenuFlyoutItem Text="Edit php.ini" Tag="{x:Bind Key}" Click="EditIni_Click" Visibility="{x:Bind PhpVis}"/>
                                                                <MenuFlyoutItem Text="Reinstall (update)" Tag="{x:Bind Key}" Click="Update_Click"/>
                                                                <MenuFlyoutSeparator/>
                                                                <MenuFlyoutItem Text="Uninstall" Tag="{x:Bind Key}" Click="Uninstall_Click"/>
                                                            </MenuFlyout>
                                                        </Button.Flyout>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
