<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BanglaHost.App.Views.CloudflareTunnelPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BanglaHost.App.Views">

    <Grid Padding="28,24,28,28" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
            <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource BhGradientHorizontal}">
                <FontIcon Glyph="&#xE72D;" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="Cloudflare Tunnel" Style="{StaticResource PageTitleStyle}" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Intro card -->
        <Border Grid.Row="1" Style="{StaticResource PremiumCard}">
            <StackPanel Spacing="6">
                <TextBlock TextWrapping="Wrap" FontWeight="SemiBold" FontSize="14"
                           Text="Publish a local site to the internet in one click."/>
                <TextBlock TextWrapping="Wrap" Opacity="0.8" FontSize="13"
                           Text="Click Start to open a temporary public https address (via Cloudflare Tunnel). No account, no port-forwarding. Click Stop to end sharing. The public URL is copied to the clipboard when a tunnel comes up."/>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                    <TextBlock x:Name="Status" Opacity="0.7" FontSize="12"/>
                    <ProgressRing x:Name="Busy" Width="18" Height="18" IsActive="False"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Site list -->
        <Border Grid.Row="2" Style="{StaticResource ListCard}">
            <Grid>
                <TextBlock x:Name="Empty" Text="No sites yet. Add one on the Sites page." Opacity="0.6" Padding="14" Visibility="Collapsed"/>
                <ListView x:Name="List" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:TunnelRow">
                            <Grid Padding="12,10" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Ellipse Width="9" Height="9" Fill="{x:Bind DotBrush}"/>
                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind LocalUrl}" FontSize="12" Opacity="0.7"/>
                                    <HyperlinkButton Content="{x:Bind PublicUrl}" NavigateUri="{x:Bind PublicUri}" Padding="0" Visibility="{x:Bind PublicVisibility}"/>
                                </StackPanel>
                                <Button Grid.Column="2" Tag="{x:Bind Name}" Click="Copy_Click" Content="Copy URL"
                                        IsEnabled="{x:Bind IsOn}" VerticalAlignment="Center"/>
                                <Button Grid.Column="3" Tag="{x:Bind Name}" Click="Toggle_Click" Content="{x:Bind ActionLabel}"
                                        MinWidth="90" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Page>
