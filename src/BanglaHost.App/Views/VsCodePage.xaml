<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BanglaHost.App.Views.VsCodePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="28,24,28,28" Spacing="18">
            <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border Width="36" Height="36" CornerRadius="10">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#FF0284C7" Offset="0"/>
                                <GradientStop Color="#FF38BDF8" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <FontIcon Glyph="&#xE8A5;" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="VS Code Integration" Style="{StaticResource PageTitleStyle}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Launch your sites in Visual Studio Code and manage recommended extensions."
                           Style="{StaticResource PageSubtitleStyle}" Margin="48,0,0,0"/>
            </StackPanel>

            <Border Style="{StaticResource PremiumCard}">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <TextBlock x:Name="StatusLabel" Text="Checking VS Code installation..." VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <Button Content="Refresh Status" Click="RefreshBtn_Click" Style="{StaticResource PillButton}"/>
                </StackPanel>
            </Border>

            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Open Projects -->
                <StackPanel Grid.Column="0" Spacing="12">
                    <TextBlock Text="Open Site in VS Code" FontWeight="SemiBold"/>
                    <Border Style="{StaticResource ListCard}" MinHeight="300">
                        <ListView x:Name="SiteList">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Grid Padding="14,10" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind}" FontWeight="SemiBold"/>
                                        <Button Grid.Column="1" Content="Open in VS Code" Click="OpenProject_Click" Tag="{x:Bind}" CornerRadius="16" Background="{StaticResource BhBrandBrush}" Foreground="White"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                </StackPanel>

                <!-- Right: Extensions -->
                <StackPanel Grid.Column="1" Spacing="12">
                    <TextBlock Text="Recommended Extensions" FontWeight="SemiBold"/>
                    <Border Style="{StaticResource ListCard}" MinHeight="300">
                        <StackPanel Spacing="0">
                            <!-- PHP Intelephense -->
                            <Grid Padding="14,12" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="PHP Intelephense" FontWeight="SemiBold"/>
                                    <TextBlock Text="Essential code intelligence for PHP." FontSize="12" Opacity="0.7"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Install" Click="InstallExt_Click" Tag="bmewburn.vscode-intelephense-client" CornerRadius="8"/>
                            </Grid>

                            <!-- Laravel Extra Intellisense -->
                            <Grid Padding="14,12" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Laravel Extra Intellisense" FontWeight="SemiBold"/>
                                    <TextBlock Text="Better autocomplete for routes, views, config." FontSize="12" Opacity="0.7"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Install" Click="InstallExt_Click" Tag="amiralizadeh9480.laravel-extra-intellisense" CornerRadius="8"/>
                            </Grid>

                            <!-- Prettier -->
                            <Grid Padding="14,12" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Prettier" FontWeight="SemiBold"/>
                                    <TextBlock Text="Code formatter for web technologies." FontSize="12" Opacity="0.7"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Install" Click="InstallExt_Click" Tag="esbenp.prettier-vscode" CornerRadius="8"/>
                            </Grid>
                            
                            <!-- Docker -->
                            <Grid Padding="14,12" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Docker" FontWeight="SemiBold"/>
                                    <TextBlock Text="Create, manage, and debug containerized apps." FontSize="12" Opacity="0.7"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Install" Click="InstallExt_Click" Tag="ms-azuretools.vscode-docker" CornerRadius="8"/>
                            </Grid>
                            
                            <!-- Logs -->
                            <TextBox x:Name="ExtLog" Height="100" Margin="14" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"
                                     IsReadOnly="True" BorderThickness="0" Background="Transparent"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
