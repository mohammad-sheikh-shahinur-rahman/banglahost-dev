<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BanglaHost.App.Views.SchedulerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="28,24,28,28" Spacing="18">
            <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border Width="36" Height="36" CornerRadius="10">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#FFF59E0B" Offset="0"/>
                                <GradientStop Color="#FFF97316" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <FontIcon Glyph="&#xE787;" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Task Scheduler" Style="{StaticResource PageTitleStyle}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Style="{StaticResource PageSubtitleStyle}" Text="Cron-style scheduled tasks. Backed by Windows Task Scheduler under the hood." Margin="48,0,0,0"/>
            </StackPanel>

            <Border Style="{StaticResource PremiumCard}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Schedule a new job" Style="{StaticResource CardTitleStyle}"/>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="NameBox" PlaceholderText="Job name" CornerRadius="8"/>
                        <TextBox Grid.Column="1" x:Name="CronBox" PlaceholderText="Cron (e.g. 0 * * * *)" Text="0 * * * *" CornerRadius="8"/>
                        <TextBox Grid.Column="2" x:Name="CmdBox" PlaceholderText="Command (e.g. php artisan schedule:run)" CornerRadius="8"/>
                        <Button Grid.Column="3" x:Name="AddBtn" Content="Schedule"
                                Style="{StaticResource PillButton}" Click="Add_Click"/>
                    </Grid>
                    <TextBlock x:Name="Result" Style="{StaticResource LabelStyle}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon Glyph="&#xE787;" FontSize="14" Foreground="#FFF59E0B"/>
                <TextBlock Text="Active jobs" Style="{StaticResource SectionTitleStyle}"/>
            </StackPanel>
            <Border Style="{StaticResource PremiumCard}" MinHeight="80">
                <TextBlock x:Name="JobsText" Text="No jobs scheduled yet." Opacity="0.6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
