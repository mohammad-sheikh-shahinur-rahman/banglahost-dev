<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BanglaHost.App.Views.PythonPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BanglaHost.App.Views">

    <ScrollViewer>
    <StackPanel Padding="28,24,28,28" Spacing="18">
        <!-- ════ Header ════ -->
        <StackPanel Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Border Width="36" Height="36" CornerRadius="10">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                            <GradientStop Color="#FFEAB308" Offset="0"/>
                            <GradientStop Color="#FF3B82F6" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <FontIcon Glyph="&#xE943;" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Python" Style="{StaticResource PageTitleStyle}" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Style="{StaticResource PageSubtitleStyle}" Text="A managed Python interpreter + supervised Python-app sites (Flask / Django / FastAPI / Gunicorn / Uvicorn)" Margin="48,0,0,0"/>
        </StackPanel>

        <!-- ════ Interpreter ════ -->
        <StackPanel Orientation="Horizontal" Spacing="10">
            <FontIcon Glyph="&#xE943;" FontSize="14" Foreground="#FFEAB308"/>
            <TextBlock Text="Interpreter" Style="{StaticResource SectionTitleStyle}"/>
        </StackPanel>
        <Border Style="{StaticResource PremiumCard}">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock x:Name="InterpStatus" VerticalAlignment="Center" Text="checking…"/>
                <Button x:Name="InstallPyBtn" Content="Install Python" Click="InstallPy_Click" Style="{StaticResource PillButton}"/>
                <ProgressRing x:Name="Busy" IsActive="False" Width="22" Height="22" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ════ Python apps ════ -->
        <Grid>
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE943;" FontSize="14" Foreground="#FFEAB308"/>
                <TextBlock Text="Python apps" Style="{StaticResource SectionTitleStyle}"/>
            </StackPanel>
            <Button Content="Add Python app" Click="AddApp_Click" HorizontalAlignment="Right" Style="{StaticResource PillButton}"/>
        </Grid>
        <Border Style="{StaticResource ListCard}">
            <StackPanel>
                <Grid Padding="10,8" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="Show" VerticalAlignment="Center" Opacity="0.7"/>
                        <ComboBox x:Name="AppPageSizeBox" Width="80" SelectionChanged="AppPageSize_Changed" CornerRadius="8"/>
                    </StackPanel>
                    <TextBox Grid.Column="2" x:Name="AppSearchBox" PlaceholderText="search…" Width="200" TextChanged="AppSearch_Changed" CornerRadius="10"/>
                </Grid>
                <TextBlock x:Name="EmptyApps" Text="No Python apps yet. Click &#x201C;Add Python app&#x201D;." Opacity="0.6" Padding="14" Visibility="Collapsed"/>
                <ListView x:Name="AppsList" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:PyAppRow">
                            <Grid Padding="10,8" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0" Width="10" Height="10" Fill="{x:Bind DotBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{x:Bind Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{x:Bind Detail}" Opacity="0.7" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6">
                                    <Button Content="Open" Tag="{x:Bind Url}" Click="OpenApp_Click" CornerRadius="16"/>
                                    <Button Content="Start" Tag="{x:Bind Name}" Click="StartApp_Click" CornerRadius="16"/>
                                    <Button Content="Stop" Tag="{x:Bind Name}" Click="StopApp_Click" CornerRadius="16"/>
                                    <Button ToolTipService.ToolTip="More" CornerRadius="8">
                                        <FontIcon Glyph="&#xE712;" FontSize="14"/>
                                        <Button.Flyout>
                                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                <MenuFlyoutItem Text="Restart" Tag="{x:Bind Name}" Click="RestartApp_Click"/>
                                                <MenuFlyoutItem Text="pip install" Tag="{x:Bind Name}" Click="PipApp_Click"/>
                                                <MenuFlyoutSeparator/>
                                                <MenuFlyoutItem Text="Open folder" Tag="{x:Bind Name}" Click="FolderApp_Click"/>
                                                <MenuFlyoutItem Text="Open in code editor" Tag="{x:Bind Name}" Click="EditorApp_Click"/>
                                                <MenuFlyoutItem Text="Open terminal here" Tag="{x:Bind Name}" Click="TerminalApp_Click"/>
                                                <MenuFlyoutItem Text="View logs" Tag="{x:Bind Name}" Click="LogsApp_Click"/>
                                                <MenuFlyoutSeparator/>
                                                <MenuFlyoutItem Text="Remove" Tag="{x:Bind Name}" Click="RemoveApp_Click"/>
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Grid x:Name="AppPager" Padding="10,10" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Button x:Name="AppPrevBtn" Click="AppPrev_Click" CornerRadius="20"><FontIcon Glyph="&#xE76B;" FontSize="12"/></Button>
                        <TextBlock x:Name="AppPageLabel" VerticalAlignment="Center" Opacity="0.8"/>
                        <Button x:Name="AppNextBtn" Click="AppNext_Click" CornerRadius="20"><FontIcon Glyph="&#xE76C;" FontSize="12"/></Button>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
    </ScrollViewer>
</Page>
