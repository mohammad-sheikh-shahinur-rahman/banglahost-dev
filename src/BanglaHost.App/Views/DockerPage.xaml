<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BanglaHost.App.Views.DockerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:BanglaHost.Core">

    <ScrollViewer>
        <StackPanel Padding="28,24,28,28" Spacing="18">
            <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border Width="36" Height="36" CornerRadius="10">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#FF2563EB" Offset="0"/>
                                <GradientStop Color="#FF3B82F6" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <FontIcon Glyph="&#xE7F8;" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Docker Manager" Style="{StaticResource PageTitleStyle}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Manage Docker containers, images, and compose stacks from BanglaHost."
                           Style="{StaticResource PageSubtitleStyle}" Margin="48,0,0,0"/>
            </StackPanel>

            <Border Style="{StaticResource PremiumCard}">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <TextBlock x:Name="DockerStatusLabel" Text="Checking Docker..." VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <Button x:Name="RefreshBtn" Content="Refresh" Click="RefreshBtn_Click" Style="{StaticResource PillButton}"/>
                </StackPanel>
            </Border>

            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Containers -->
                <StackPanel Grid.Column="0" Spacing="12">
                    <TextBlock Text="Containers" FontWeight="SemiBold"/>
                    <Border Style="{StaticResource ListCard}" MinHeight="300">
                        <ListView x:Name="ContainerList">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="core:DockerContainer">
                                    <Grid Padding="14,10" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{x:Bind Image}" FontSize="12" Opacity="0.7"/>
                                            <TextBlock Text="{x:Bind Status}" FontSize="12" Opacity="0.5"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Button Content="Start" Click="StartContainer_Click" Tag="{x:Bind Id}" CornerRadius="8" Padding="8,4"/>
                                            <Button Content="Stop" Click="StopContainer_Click" Tag="{x:Bind Id}" CornerRadius="8" Padding="8,4"/>
                                            <Button Content="Logs" Click="LogsContainer_Click" Tag="{x:Bind Id}" CornerRadius="8" Padding="8,4"/>
                                            <Button Content="Rm" Click="RemoveContainer_Click" Tag="{x:Bind Id}" CornerRadius="8" Foreground="{StaticResource BhErrorBrush}" Padding="8,4"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                </StackPanel>

                <!-- Right: Images + Quick Actions -->
                <StackPanel Grid.Column="1" Spacing="16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Images" FontWeight="SemiBold"/>
                        <Border Style="{StaticResource ListCard}" MinHeight="200">
                            <ListView x:Name="ImageList">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="core:DockerImage">
                                        <Grid Padding="14,8" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                                            <StackPanel Spacing="3">
                                                <TextBlock FontWeight="SemiBold">
                                                    <Run Text="{x:Bind Repository}"/><Run Text=":"/><Run Text="{x:Bind Tag}"/>
                                                </TextBlock>
                                                <TextBlock Text="{x:Bind Size}" FontSize="12" Opacity="0.7"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Border>
                    </StackPanel>

                    <Border Style="{StaticResource PremiumCard}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Quick Run" Style="{StaticResource CardTitleStyle}"/>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="PullImageBox" Grid.Column="0" PlaceholderText="Image name (e.g. mysql:8)"/>
                                <Button Content="Pull &amp; Run" Grid.Column="1" Click="PullAndRun_Click" Style="{StaticResource PillButton}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PremiumCard}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Container Logs" Style="{StaticResource CardTitleStyle}"/>
                            <TextBox x:Name="LogViewer" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" Height="150"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto" IsReadOnly="True" BorderThickness="0" Background="Transparent"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
