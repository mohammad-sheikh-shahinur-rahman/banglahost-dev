<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BanglaHost.App.Views.BackupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:BanglaHost.Core">

    <ScrollViewer>
        <StackPanel Padding="28,24,28,28" Spacing="18">
            <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border Width="36" Height="36" CornerRadius="10">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#FF06B6D4" Offset="0"/>
                                <GradientStop Color="#FF3B82F6" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <FontIcon Glyph="&#xE895;" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Backup" Style="{StaticResource PageTitleStyle}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Snapshot every site and database into a single compressed archive."
                           Style="{StaticResource PageSubtitleStyle}" Margin="48,0,0,0"/>
            </StackPanel>

            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="16">
                    <Border Style="{StaticResource PremiumCard}">
                        <StackPanel Spacing="14">
                            <TextBlock Text="Create a new backup" Style="{StaticResource CardTitleStyle}"/>
                            <TextBlock Text="This will create a compressed ZIP archive containing all your sites and databases." FontSize="13" Opacity="0.7" TextWrapping="Wrap"/>
                            
                            <StackPanel Spacing="8">
                                <TextBlock Text="Backup Name" FontSize="12" Opacity="0.7"/>
                                <TextBox x:Name="BackupNameBox"/>
                            </StackPanel>

                            <Button x:Name="BackupAllBtn" Content="Start Full Backup" Click="BackupAll_Click" 
                                    Style="{StaticResource PillButton}" Background="{StaticResource BhBrandBrush}" Foreground="White"
                                    HorizontalAlignment="Stretch" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="OpBanner" Visibility="Collapsed" CornerRadius="12" Padding="16" BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#146366F1" Offset="0"/>
                                <GradientStop Color="#0806B6D4" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel Spacing="8">
                            <TextBlock Text="Backup in progress..." FontWeight="SemiBold"/>
                            <ProgressBar x:Name="OpBar" IsIndeterminate="True" CornerRadius="4"/>
                            <TextBlock x:Name="OpMsg" Style="{StaticResource LabelStyle}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="12">
                    <TextBlock Text="Recent Backups" FontWeight="SemiBold"/>
                    <Border Style="{StaticResource ListCard}" MinHeight="300">
                        <ListView x:Name="BackupList">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="core:BackupRecord">
                                    <Grid Padding="14,10" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{x:Bind Date}" Style="{StaticResource LabelStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Button Content="Restore" Click="RestoreBtn_Click" Tag="{x:Bind Path}" CornerRadius="16"/>
                                            <Button Content="Delete" Click="DeleteBtn_Click" Tag="{x:Bind Id}" CornerRadius="16" Foreground="{StaticResource BhErrorBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
