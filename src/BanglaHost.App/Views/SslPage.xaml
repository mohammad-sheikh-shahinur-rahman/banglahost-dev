<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BanglaHost.App.Views.SslPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:BanglaHost.Core">

    <ScrollViewer>
        <StackPanel Padding="28,24,28,28" Spacing="18">
            <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border Width="36" Height="36" CornerRadius="10">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#FF22C55E" Offset="0"/>
                                <GradientStop Color="#FF14B8A6" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <FontIcon Glyph="&#xE72E;" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="SSL Certificates" Style="{StaticResource PageTitleStyle}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Manage local mkcert certificates and production Let's Encrypt certificates."
                           Style="{StaticResource PageSubtitleStyle}" Margin="48,0,0,0"/>
            </StackPanel>

            <StackPanel Spacing="24">
                <StackPanel Spacing="16">
                    <Border Style="{StaticResource PremiumCard}">
                        <StackPanel Spacing="14">
                            <TextBlock Text="Generate New Certificate" Style="{StaticResource CardTitleStyle}"/>
                            <TextBlock Text="Local domains (*.test) use mkcert. Public domains can use Let's Encrypt." FontSize="13" Opacity="0.7" TextWrapping="Wrap"/>
                            
                            <StackPanel Spacing="8">
                                <TextBlock Text="Domain Name" FontSize="12" Opacity="0.7"/>
                                <TextBox x:Name="DomainBox" PlaceholderText="e.g. mysite.test or example.com"/>
                            </StackPanel>

                            <StackPanel Spacing="8" x:Name="LetsEncryptPanel" Visibility="Collapsed">
                                <TextBlock Text="Email (for Let's Encrypt expiry notices)" FontSize="12" Opacity="0.7"/>
                                <TextBox x:Name="EmailBox" PlaceholderText="admin@example.com"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                                <Button x:Name="GenLocalBtn" Content="Generate Local (mkcert)" Click="GenLocalBtn_Click" 
                                        Style="{StaticResource PillButton}" Background="{ThemeResource BhBrandBrush}" Foreground="White"/>
                                <Button x:Name="GenLeBtn" Content="Generate Let's Encrypt" Click="GenLeBtn_Click" 
                                        Style="{StaticResource PillButton}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border x:Name="OpBanner" Visibility="Collapsed" CornerRadius="12" Padding="16" BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#146366F1" Offset="0"/>
                                <GradientStop Color="#0806B6D4" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel Spacing="8">
                            <TextBlock Text="Generating Certificate..." FontWeight="SemiBold"/>
                            <ProgressBar x:Name="OpBar" IsIndeterminate="True" CornerRadius="4"/>
                            <TextBlock x:Name="OpMsg" Style="{StaticResource LabelStyle}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="Installed Certificates" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Click="Refresh_Click" CornerRadius="16" Padding="4,2">
                            <FontIcon Glyph="&#xE72C;" FontSize="12"/>
                        </Button>
                    </StackPanel>
                    <Border Style="{StaticResource ListCard}" MinHeight="300">
                        <ListView x:Name="SslList">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="core:SslCertInfo">
                                    <Grid Padding="14,10" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="{x:Bind Domain}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{x:Bind Issuer}" Style="{StaticResource LabelStyle}" Opacity="0.7"/>
                                            <TextBlock Text="{x:Bind ValidTo}" Style="{StaticResource LabelStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Button Content="Revoke / Delete" Click="DeleteBtn_Click" Tag="{x:Bind Domain}" CornerRadius="16" Foreground="{ThemeResource BhErrorBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
