<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BanglaHost.App.Views.PhpManagerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="28,24,28,28" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource BhGradientBrush}">
                    <FontIcon Glyph="&#xE81E;" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="PHP Version Manager" Style="{StaticResource PageTitleStyle}" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="Download, install, and switch PHP versions directly from windows.php.net."
                       Style="{StaticResource PageSubtitleStyle}" Margin="48,0,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource PremiumCard}" Padding="15">
            <StackPanel Spacing="16">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBox x:Name="VerBox" PlaceholderText="Version (e.g. 8.4)" Width="150"/>
                    <Button Content="Install PHP" Click="Install_Click" Style="{StaticResource AccentButtonStyle}"/>
                    <ProgressRing x:Name="Busy" IsActive="False" Width="20" Height="20" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Quick Install:" Opacity="0.7" VerticalAlignment="Center"/>
                    <Button Content="8.1" Tag="8.1" Click="Quick_Click" CornerRadius="16"/>
                    <Button Content="8.2" Tag="8.2" Click="Quick_Click" CornerRadius="16"/>
                    <Button Content="8.3" Tag="8.3" Click="Quick_Click" CornerRadius="16"/>
                    <Button Content="8.4" Tag="8.4" Click="Quick_Click" CornerRadius="16"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource PremiumCard}" Margin="0,15,0,0">
            <StackPanel Spacing="15">
                <TextBlock Text="Installed PHP Versions" FontWeight="SemiBold"/>
                <ListView x:Name="VersList" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Grid Padding="0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind}" VerticalAlignment="Center" Grid.Column="0" FontWeight="SemiBold"/>
                                <Button Content="Make Default" Tag="{x:Bind}" Click="MakeDefault_Click" Grid.Column="1" Margin="0,0,10,0"/>
                                <Button Content="Uninstall" Tag="{x:Bind}" Click="Remove_Click" Grid.Column="2" Foreground="#FFDC2626"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBox x:Name="OutputBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" Height="150" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
