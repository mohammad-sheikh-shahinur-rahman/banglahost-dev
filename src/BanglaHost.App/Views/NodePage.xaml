<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BanglaHost.App.Views.NodePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BanglaHost.App.Views">

    <ScrollViewer>
    <StackPanel Padding="28,24,28,28" Spacing="18">
        <!-- ════ Header ════ -->
        <StackPanel Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Border Width="36" Height="36" CornerRadius="10">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                            <GradientStop Color="#FF22C55E" Offset="0"/>
                            <GradientStop Color="#FF16A34A" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <FontIcon Glyph="&#xE7B8;" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Node.js" Style="{StaticResource PageTitleStyle}" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Style="{StaticResource PageSubtitleStyle}" Text="Multiple Node versions via fnm + supervised Node-app sites" Margin="48,0,0,0"/>
        </StackPanel>

        <!-- ════ Versions ════ -->
        <StackPanel Orientation="Horizontal" Spacing="10">
            <FontIcon Glyph="&#xE7B8;" FontSize="14" Foreground="#FF22C55E"/>
            <TextBlock Text="Versions" Style="{StaticResource SectionTitleStyle}"/>
        </StackPanel>
        <Border Style="{StaticResource PremiumCard}">
            <StackPanel Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBox x:Name="VerBox" PlaceholderText="version (e.g. 20, 22, lts)" Width="170" CornerRadius="8"/>
                    <Button Content="Install" Click="Install_Click" Style="{StaticResource PillButton}"/>
                    <ProgressRing x:Name="Busy" IsActive="False" Width="22" Height="22" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Quick install:" Opacity="0.7" VerticalAlignment="Center"/>
                    <Button Content="18"     Tag="18"     Click="Quick_Click" CornerRadius="16" Padding="14,6"/>
                    <Button Content="20"     Tag="20"     Click="Quick_Click" CornerRadius="16" Padding="14,6"/>
                    <Button Content="22"     Tag="22"     Click="Quick_Click" CornerRadius="16" Padding="14,6"/>
                    <Button Content="24"     Tag="24"     Click="Quick_Click" CornerRadius="16" Padding="14,6"/>
                    <Button Content="lts"    Tag="lts"    Click="Quick_Click" CornerRadius="16" Padding="14,6"/>
                    <Button Content="latest" Tag="latest" Click="Quick_Click" CornerRadius="16" Padding="14,6"/>
                </StackPanel>
                <TextBlock x:Name="EmptyVers" Text="No Node versions installed yet." Opacity="0.6" Visibility="Collapsed"/>
                <ItemsControl x:Name="VersList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:NodeVerRow">
                            <Grid Padding="6,7" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/><ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Bind Display}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" VerticalAlignment="Center" CornerRadius="6" Padding="8,3"
                                        Background="{StaticResource BhGradientHorizontal}" Visibility="{x:Bind DefaultVis}">
                                    <TextBlock Text="default" FontSize="11" Foreground="White" FontWeight="SemiBold"/>
                                </Border>
                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6">
                                    <Button Content="Use as default" Tag="{x:Bind Version}" Click="Use_Click" IsEnabled="{x:Bind NotDefault}" CornerRadius="16"/>
                                    <Button Content="Uninstall" Tag="{x:Bind Version}" Click="UninstallVer_Click" CornerRadius="16"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- ════ Node apps ════ -->
        <Grid>
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE7B8;" FontSize="14" Foreground="#FF22C55E"/>
                <TextBlock Text="Node apps" Style="{StaticResource SectionTitleStyle}"/>
            </StackPanel>
            <Button Content="Add Node app" Click="AddApp_Click" HorizontalAlignment="Right" Style="{StaticResource PillButton}"/>
        </Grid>
        <Border Style="{StaticResource ListCard}">
            <StackPanel>
            <Grid Padding="10,8" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="Show" VerticalAlignment="Center" Opacity="0.7"/>
                    <ComboBox x:Name="AppPageSizeBox" Width="80" SelectionChanged="AppPageSize_Changed" CornerRadius="8"/>
                </StackPanel>
                <TextBox Grid.Column="2" x:Name="AppSearchBox" PlaceholderText="search…" Width="200" TextChanged="AppSearch_Changed" CornerRadius="10"/>
            </Grid>
            <TextBlock x:Name="EmptyApps" Text="No Node apps yet." Opacity="0.6" Padding="14" Visibility="Collapsed"/>
            <ListView x:Name="AppsList" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:NodeAppRow">
                        <Grid Padding="10,8" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Grid.Column="0" Width="10" Height="10" Fill="{x:Bind DotBrush}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{x:Bind Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{x:Bind Detail}" Opacity="0.7" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6">
                                <Button Content="Open" Tag="{x:Bind Url}" Click="OpenApp_Click" CornerRadius="16"/>
                                <Button Content="Start" Tag="{x:Bind Name}" Click="StartApp_Click" CornerRadius="16"/>
                                <Button Content="Stop" Tag="{x:Bind Name}" Click="StopApp_Click" CornerRadius="16"/>
                                <Button ToolTipService.ToolTip="More" CornerRadius="8">
                                    <FontIcon Glyph="&#xE712;" FontSize="14"/>
                                    <Button.Flyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="Restart" Tag="{x:Bind Name}" Click="RestartApp_Click"/>
                                            <MenuFlyoutItem Text="Open folder" Tag="{x:Bind Name}" Click="FolderApp_Click"/>
                                            <MenuFlyoutItem Text="View logs" Tag="{x:Bind Name}" Click="LogsApp_Click"/>
                                            <MenuFlyoutSeparator/>
                                            <MenuFlyoutItem Text="npm install (frontend)" Tag="{x:Bind Name}" Click="NpmFe_Click"/>
                                            <MenuFlyoutItem Text="npm install (backend)" Tag="{x:Bind Name}" Click="NpmBe_Click" Visibility="{x:Bind HasBackendVis}"/>
                                            <MenuFlyoutItem Text="Edit .env (frontend)" Tag="{x:Bind Name}" Click="EnvFe_Click"/>
                                            <MenuFlyoutItem Text="Edit .env (backend)" Tag="{x:Bind Name}" Click="EnvBe_Click" Visibility="{x:Bind HasBackendVis}"/>
                                            <MenuFlyoutItem Text="Edit config" Tag="{x:Bind Name}" Click="EditApp_Click"/>
                                            <MenuFlyoutSeparator/>
                                            <MenuFlyoutItem Text="Remove" Tag="{x:Bind Name}" Click="RemoveApp_Click"/>
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Grid x:Name="AppPager" Padding="10,10" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Button x:Name="AppPrevBtn" Click="AppPrev_Click" CornerRadius="20"><FontIcon Glyph="&#xE76B;" FontSize="12"/></Button>
                    <TextBlock x:Name="AppPageLabel" VerticalAlignment="Center" Opacity="0.8"/>
                    <Button x:Name="AppNextBtn" Click="AppNext_Click" CornerRadius="20"><FontIcon Glyph="&#xE76C;" FontSize="12"/></Button>
                </StackPanel>
            </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
    </ScrollViewer>
</Page>
