<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BanglaHost.App.Views.CachePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="28,24,28,28" Spacing="18">
            <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border Width="36" Height="36" CornerRadius="10">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#FFF59E0B" Offset="0"/>
                                <GradientStop Color="#FFFBBF24" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <FontIcon Glyph="&#xE946;" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Cache Manager" Style="{StaticResource PageTitleStyle}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Monitor Redis cache and PHP OPCache. Flush, inspect keys, and optimize."
                           Style="{StaticResource PageSubtitleStyle}" Margin="48,0,0,0"/>
            </StackPanel>

            <!-- Stats Cards -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource PremiumCard}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Cached Keys" FontSize="12" Opacity="0.7"/>
                        <TextBlock x:Name="KeysLabel" Text="--" FontSize="22" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource PremiumCard}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Memory Used" FontSize="12" Opacity="0.7"/>
                        <TextBlock x:Name="MemLabel" Text="--" FontSize="22" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource PremiumCard}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Hit Ratio" FontSize="12" Opacity="0.7"/>
                        <TextBlock x:Name="HitLabel" Text="--" FontSize="22" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource PremiumCard}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Uptime" FontSize="12" Opacity="0.7"/>
                        <TextBlock x:Name="UptimeLabel" Text="--" FontSize="22" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Redis Keys -->
                <StackPanel Grid.Column="0" Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="Redis Keys" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Click="RefreshKeys_Click" CornerRadius="16" Padding="4,2"><FontIcon Glyph="&#xE72C;" FontSize="12"/></Button>
                        <Button Content="Flush All" Click="FlushAll_Click" CornerRadius="16" Foreground="{StaticResource BhErrorBrush}"/>
                    </StackPanel>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="KeyPatternBox" Grid.Column="0" PlaceholderText="Key pattern (e.g. laravel_cache:*)"/>
                        <Button Content="Search" Grid.Column="1" Click="SearchKeys_Click" Style="{StaticResource PillButton}"/>
                    </Grid>
                    <Border Style="{StaticResource ListCard}" MinHeight="250">
                        <ListView x:Name="KeyList">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Grid Padding="14,8" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind}" FontFamily="Consolas" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                        <Button Grid.Column="1" Content="Del" Click="DeleteKey_Click" Tag="{x:Bind}" CornerRadius="8" Foreground="{StaticResource BhErrorBrush}" Padding="4,2"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                </StackPanel>

                <!-- OPCache -->
                <StackPanel Grid.Column="1" Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="PHP OPCache" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Content="Reset OPCache" Click="ResetOpcache_Click" CornerRadius="16"/>
                    </StackPanel>
                    <Border Style="{StaticResource PremiumCard}" MinHeight="250">
                        <TextBox x:Name="OpcacheInfo" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" IsReadOnly="True"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent"/>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
