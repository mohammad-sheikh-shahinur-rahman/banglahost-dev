<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BanglaHost.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="28,24,28,28" Spacing="18" MaxWidth="700" HorizontalAlignment="Left">
            <!-- ════ Header ════ -->
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource BhGradientBrush}">
                    <FontIcon Glyph="&#xE713;" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Settings" Style="{StaticResource PageTitleStyle}" VerticalAlignment="Center"/>
            </StackPanel>

                        <Border Style="{StaticResource PremiumCard}">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE774;" FontSize="14" Foreground="{StaticResource BhInfoBrush}"/>
                        <TextBlock x:Uid="SettingsLanguageTitle" Style="{StaticResource CardTitleStyle}"/>
                    </StackPanel>
                    <TextBlock x:Uid="SettingsLanguageDesc" Opacity="0.7"/>
                    <ComboBox x:Name="LangBox" Width="200" CornerRadius="8" SelectionChanged="LangBox_SelectionChanged">
                        <ComboBoxItem Content="English" Tag="en-US"/>
                        <ComboBoxItem Content="?????" Tag="bn-BD"/>
                    </ComboBox>
                </StackPanel>
            </Border>
            <!-- ? Domains, ports & defaults ════ -->
            <Border Style="{StaticResource PremiumCard}">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE774;" FontSize="14" Foreground="{StaticResource BhInfoBrush}"/>
                        <TextBlock Text="Domains, ports &amp; defaults" Style="{StaticResource CardTitleStyle}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBox  x:Name="TldBox"   Header="TLD" Width="120" CornerRadius="8"/>
                        <NumberBox x:Name="HttpBox"  Header="HTTP port"  Width="130" Minimum="1" Maximum="65535" SpinButtonPlacementMode="Compact" CornerRadius="8"/>
                        <NumberBox x:Name="HttpsBox" Header="HTTPS port" Width="130" Minimum="1" Maximum="65535" SpinButtonPlacementMode="Compact" CornerRadius="8"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <ComboBox x:Name="PhpDefBox" Header="Default PHP" Width="120" CornerRadius="8"/>
                        <ComboBox x:Name="WebDefBox" Header="Default web server" Width="160" CornerRadius="8">
                            <ComboBoxItem Content="nginx"/>
                            <ComboBoxItem Content="apache"/>
                        </ComboBox>
                    </StackPanel>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="RootBox" Header="Sites root" Grid.Column="0" CornerRadius="8"/>
                        <Button Content="Browse…" Grid.Column="1" Click="BrowseRoot_Click" VerticalAlignment="Bottom" CornerRadius="16"/>
                    </Grid>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Data directory" Opacity="0.7" VerticalAlignment="Center"/>
                        <TextBlock x:Name="HomeText" Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        <Button Content="Change…" Grid.Column="2" Click="MoveData_Click" VerticalAlignment="Center" CornerRadius="16"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button x:Name="SaveBtn" Content="Save" Click="Save_Click" Style="{StaticResource PillButton}"/>
                        <Button Content="Revert" Click="Revert_Click" CornerRadius="16"/>
                        <ProgressRing x:Name="Busy" IsActive="False" Width="18" Height="18" VerticalAlignment="Center"/>
                        <TextBlock x:Name="SaveStatus" Opacity="0.7" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBlock Text="Changing the TLD or ports re-renders all vhosts and restarts nginx. After a TLD change, re-issue HTTPS per site." Opacity="0.5" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- ════ App behavior ════ -->
            <Border Style="{StaticResource PremiumCard}">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE912;" FontSize="14" Foreground="{StaticResource BhInfoBrush}"/>
                        <TextBlock Text="App behavior" Style="{StaticResource CardTitleStyle}"/>
                    </StackPanel>
                    <ToggleSwitch x:Name="AutostartToggle" Header="Start BanglaHost at login" OffContent="Off" OnContent="On" Toggled="Autostart_Toggled"/>
                    <ToggleSwitch x:Name="StartSvcToggle" Header="Start services when BanglaHost launches" OffContent="Off" OnContent="On" Toggled="Flag_Toggled"/>
                    <ToggleSwitch x:Name="TrayToggle" Header="Keep running in the system tray when the window is closed"
                                  OffContent="Off — closing the window quits BanglaHost" OnContent="On — sites stay up in the background" Toggled="Tray_Toggled"/>
                    <ToggleSwitch x:Name="AutoUpdateToggle" Header="Automatically check for updates" OffContent="Off" OnContent="On" Toggled="Flag_Toggled"/>
                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,4"/>
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <NumberBox x:Name="DashSizeBox" Header="Dashboard list — sites per page" Width="230"
                                   Minimum="1" Maximum="500" SpinButtonPlacementMode="Inline" ValueChanged="ListSize_Changed" CornerRadius="8"/>
                        <NumberBox x:Name="SitesSizeBox" Header="Sites page — sites per page" Width="230"
                                   Minimum="1" Maximum="500" SpinButtonPlacementMode="Inline" ValueChanged="ListSize_Changed" CornerRadius="8"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="Open data folder" Click="OpenFolder_Click" CornerRadius="16"/>
                        <Button x:Name="UpdateBtn" Content="Check for updates" Click="CheckUpdates_Click" CornerRadius="16"/>
                        <ProgressRing x:Name="UpdateBusy" IsActive="False" Width="18" Height="18" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="UpdateStatus" Opacity="0.7" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="Version" Opacity="0.45" FontSize="12"/>
        </StackPanel>
    </ScrollViewer>
</Page>
