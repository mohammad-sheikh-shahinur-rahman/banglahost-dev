<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BanglaHost.App.Views.PhpExtensionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BanglaHost.App.Views">

    <ScrollViewer>
        <StackPanel Padding="28,24,28,28" Spacing="18">
            <!-- ════ Header ════ -->
            <Grid>
                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource BhGradientBrush}">
                            <FontIcon Glyph="&#xE9F5;" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Extensions" Style="{StaticResource PageTitleStyle}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Manage PHP extensions, install PECL modules, and configure ionCube loader."
                               Style="{StaticResource PageSubtitleStyle}" Margin="48,0,0,0"/>
                </StackPanel>
                <ProgressRing x:Name="Busy" IsActive="False" Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
            
            <Border Style="{StaticResource PremiumCard}">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="Select PHP Version:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <ComboBox x:Name="VersionBox" Width="120" SelectionChanged="VersionBox_SelectionChanged"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ════ Operation banner ════ -->
            <Border x:Name="OpBanner" Visibility="Collapsed" CornerRadius="12" Padding="16" BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#146366F1" Offset="0"/>
                        <GradientStop Color="#0806B6D4" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel Spacing="8">
                    <Grid>
                        <TextBlock x:Name="OpName" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                            <TextBlock x:Name="OpPct" Opacity="0.7" VerticalAlignment="Center"/>
                            <Button x:Name="OpDismiss" Content="Dismiss" Click="OpDismiss_Click" Visibility="Collapsed" CornerRadius="16"/>
                        </StackPanel>
                    </Grid>
                    <ProgressBar x:Name="OpBar" Minimum="0" Maximum="100" CornerRadius="4"/>
                    <TextBlock x:Name="OpMsg" Style="{StaticResource LabelStyle}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- ════ Extensions Grid ════ -->
            <ItemsControl x:Name="ExtList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:ExtRow">
                        <Border Style="{StaticResource PremiumCard}" Margin="0,0,0,12" Opacity="{x:Bind Opacity}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16">
                                    <Border Width="40" Height="40" CornerRadius="8" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                        <FontIcon Glyph="&#xE9F5;" FontSize="18" Foreground="{StaticResource BhBrandBrush}"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="16"/>
                                            <Border Background="#1A6366F1" CornerRadius="4" Padding="6,2" Visibility="{x:Bind IsZendVis}" VerticalAlignment="Center">
                                                <TextBlock Text="Zend Ext" FontSize="11" Foreground="{StaticResource BhBrandBrush}" FontWeight="SemiBold"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind Description}" Opacity="0.7" FontSize="12" Margin="0,2,0,0" Visibility="{x:Bind DescVis}"/>
                                        <TextBlock Text="{x:Bind MissingDepsText}" Foreground="{StaticResource BhErrorBrush}" FontSize="12" Margin="0,4,0,0" Visibility="{x:Bind MissingDepsVis}"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind StatusText}" Opacity="0.6" VerticalAlignment="Center"/>
                                    <ToggleSwitch IsOn="{x:Bind Enabled, Mode=TwoWay}" Toggled="ExtToggle_Toggled" Tag="{x:Bind Name}" Margin="0,0,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            
        </StackPanel>
    </ScrollViewer>
</Page>
