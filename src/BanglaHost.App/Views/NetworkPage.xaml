<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BanglaHost.App.Views.NetworkPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:BanglaHost.Core">

    <ScrollViewer>
        <StackPanel Padding="28,24,28,28" Spacing="18">
            <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border Width="36" Height="36" CornerRadius="10">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#FF6366F1" Offset="0"/>
                                <GradientStop Color="#FF818CF8" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <FontIcon Glyph="&#xE968;" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Network Inspector" Style="{StaticResource PageTitleStyle}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Monitor listening ports, network interfaces, and system performance."
                           Style="{StaticResource PageSubtitleStyle}" Margin="48,0,0,0"/>
            </StackPanel>

            <!-- Performance Cards Row -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource PremiumCard}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="CPU Usage" FontSize="12" Opacity="0.7"/>
                        <TextBlock x:Name="CpuLabel" Text="--%" FontSize="28" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource PremiumCard}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Memory (Available)" FontSize="12" Opacity="0.7"/>
                        <TextBlock x:Name="MemLabel" Text="-- MB" FontSize="28" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource PremiumCard}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="App Threads / Handles" FontSize="12" Opacity="0.7"/>
                        <TextBlock x:Name="ThreadLabel" Text="-- / --" FontSize="28" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Listening Ports -->
                <StackPanel Grid.Column="0" Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="Listening Ports" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Click="RefreshPorts_Click" CornerRadius="16" Padding="4,2">
                            <FontIcon Glyph="&#xE72C;" FontSize="12"/>
                        </Button>
                    </StackPanel>
                    <Border Style="{StaticResource ListCard}" MinHeight="300">
                        <ListView x:Name="PortList">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="core:PortInfo">
                                    <Grid Padding="14,8" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Port}" FontWeight="Bold" FontFamily="Consolas"/>
                                        <TextBlock Grid.Column="1" Text="{x:Bind Protocol}" Opacity="0.7"/>
                                        <TextBlock Grid.Column="2" Text="{x:Bind State}" Opacity="0.7"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                </StackPanel>

                <!-- Right: Network Interfaces -->
                <StackPanel Grid.Column="1" Spacing="12">
                    <TextBlock Text="Network Interfaces" FontWeight="SemiBold"/>
                    <Border Style="{StaticResource ListCard}" MinHeight="300">
                        <ListView x:Name="InterfaceList">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="core:NetworkStat">
                                    <Grid Padding="14,8" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="{x:Bind Interface}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{x:Bind Status}" FontSize="12" Opacity="0.7"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
