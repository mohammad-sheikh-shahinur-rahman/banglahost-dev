<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BanglaHost.App.Views.NpmRunnerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BanglaHost.App.Views">

    <Grid Padding="28,24,28,28" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="200"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource BhGradientBrush}">
                    <FontIcon Glyph="&#xE7B8;" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="NPM Scripts Runner" Style="{StaticResource PageTitleStyle}" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="Select a Node.js project to view and run its package.json scripts visually."
                       Style="{StaticResource PageSubtitleStyle}" Margin="48,0,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10">
            <ComboBox x:Name="ProjectBox" Width="250" PlaceholderText="Select a Project" SelectionChanged="ProjectBox_SelectionChanged"/>
            <Button Content="Refresh" Click="Refresh_Click" />
            <Button Content="Stop Process" Click="Stop_Click" Style="{StaticResource AccentButtonStyle}" Background="#FFDC2626" x:Name="StopBtn" IsEnabled="False"/>
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource PremiumCard}">
            <ListView x:Name="ScriptsList" SelectionMode="None">
                <ListView.Header>
                    <Grid Padding="12,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Script Name" FontWeight="SemiBold" Grid.Column="0"/>
                        <TextBlock Text="Command" FontWeight="SemiBold" Grid.Column="1"/>
                        <TextBlock Text="Action" FontWeight="SemiBold" Grid.Column="2" HorizontalAlignment="Right"/>
                    </Grid>
                </ListView.Header>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:NpmScriptModel">
                        <Grid Padding="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" Grid.Column="0" VerticalAlignment="Center"/>
                            <TextBlock Text="{x:Bind Command}" Grid.Column="1" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" FontFamily="Consolas"/>
                            <Button Content="Run" Tag="{x:Bind Name}" Click="Run_Click" Grid.Column="2" HorizontalAlignment="Right" Style="{StaticResource AccentButtonStyle}">
                                <Button.ContentTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE768;" FontSize="12"/>
                                            <TextBlock Text="Run" Margin="0,-2,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </Button.ContentTemplate>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <TextBox x:Name="OutputBox" Grid.Row="3" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" PlaceholderText="Command output will appear here..."/>
    </Grid>
</Page>
