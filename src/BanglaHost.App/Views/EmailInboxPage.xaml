<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BanglaHost.App.Views.EmailInboxPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BanglaHost.App.Views">

    <Grid Padding="28,24,28,28" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource BhGradientBrush}">
                    <FontIcon Glyph="&#xE715;" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Local Email Inbox" Style="{StaticResource PageTitleStyle}" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="View intercepted emails sent by your local apps (via Mailpit) without opening a browser."
                       Style="{StaticResource PageSubtitleStyle}" Margin="48,0,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Email List -->
            <Border Grid.Column="0" Style="{StaticResource PremiumCard}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Padding="15" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                        <Button Content="Refresh" Click="Refresh_Click" Style="{StaticResource AccentButtonStyle}">
                            <Button.ContentTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE72C;" FontSize="12"/>
                                        <TextBlock Text="Refresh" Margin="0,-2,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </Button.ContentTemplate>
                        </Button>
                        <Button Content="Delete All" Click="DeleteAll_Click" Background="#FFDC2626" Foreground="White"/>
                        <ProgressRing x:Name="Busy" IsActive="False" Width="20" Height="20" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>

                    <ListView x:Name="EmailList" Grid.Row="1" SelectionChanged="EmailList_SelectionChanged" SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:MailpitMessage">
                                <StackPanel Padding="10" Spacing="4">
                                    <TextBlock Text="{x:Bind Subject}" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{x:Bind From}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{x:Bind Created}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="11"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    
                    <TextBlock x:Name="EmptyMsg" Text="Inbox is empty" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed"/>
                </Grid>
            </Border>

            <!-- Email Viewer -->
            <Border Grid.Column="1" Style="{StaticResource PremiumCard}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0" Padding="20" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                        <TextBlock x:Name="ViewSubject" Text="Select an email to view" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="ViewFrom" Text="" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,5,0,0"/>
                        <TextBlock x:Name="ViewDate" Text="" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="12"/>
                    </StackPanel>

                    <!-- WebView2 is perfect for rendering the HTML body -->
                    <WebView2 x:Name="EmailWebView" Grid.Row="1" DefaultBackgroundColor="Transparent"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
