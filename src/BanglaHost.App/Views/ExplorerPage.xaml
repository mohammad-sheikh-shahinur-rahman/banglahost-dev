<Page x:Class="BanglaHost.App.Views.ExplorerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:BanglaHost.App.Views">

    <Grid Padding="28,24,28,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
            <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource BhDbAccent}">
                <FontIcon Glyph="&#xE1A3;" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Database Explorer" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Text="Browse tables, preview data, and run SQL against local databases." Style="{StaticResource PageSubtitleStyle}"/>
            </StackPanel>
        </StackPanel>

        <!-- Toolbar -->
        <Border Grid.Row="1" Style="{StaticResource PremiumCard}" Padding="14,12">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Engine" VerticalAlignment="Center" Opacity="0.7"/>
                <ComboBox Grid.Column="1" x:Name="EngineBox" Width="150" CornerRadius="8"
                          SelectionChanged="Engine_Changed" PlaceholderText="no engine running"/>

                <TextBlock Grid.Column="2" Text="Database" VerticalAlignment="Center" Opacity="0.7" Margin="6,0,0,0"/>
                <ComboBox Grid.Column="3" x:Name="DbBox" MinWidth="200" CornerRadius="8"
                          SelectionChanged="Db_Changed" PlaceholderText="select a database"/>

                <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ProgressRing x:Name="Busy" IsActive="False" Width="20" Height="20"/>
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" Opacity="0.65"/>
                </StackPanel>

                <Button Grid.Column="6" Content="Refresh" Click="Refresh_Click" CornerRadius="16"/>
                <Button Grid.Column="7" x:Name="PmaBtn" Content="Open in phpMyAdmin" Click="OpenPma_Click"
                        Style="{StaticResource PillButton}" Margin="4,0,0,0"/>
            </Grid>
        </Border>

        <!-- Body: Tables (left) + Data / SQL (right) -->
        <Grid Grid.Row="2" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Tables list -->
            <Border Grid.Column="0" Style="{StaticResource PremiumCard}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Tables" Style="{StaticResource CardTitleStyle}" Padding="16,14,16,8"/>
                    <TextBox Grid.Row="1" x:Name="TableSearch" PlaceholderText="filter tables…"
                             Margin="12,0,12,8" CornerRadius="8" TextChanged="TableSearch_Changed"/>

                    <ListView Grid.Row="2" x:Name="TableList" SelectionMode="Single"
                              SelectionChanged="Table_Changed" Padding="4,0,4,8">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <StackPanel Orientation="Horizontal" Spacing="10" Padding="8,6">
                                    <FontIcon Glyph="&#xE8A5;" FontSize="14" Opacity="0.55"/>
                                    <TextBlock Text="{x:Bind}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- SQL editor + results -->
            <Border Grid.Column="1" Style="{StaticResource PremiumCard}" Padding="16">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="SQL" Style="{StaticResource CardTitleStyle}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ContextLabel" VerticalAlignment="Center" Opacity="0.6" FontSize="12"/>
                    </StackPanel>

                    <TextBox Grid.Row="1" x:Name="QueryBox" AcceptsReturn="True" TextWrapping="Wrap"
                             MinHeight="90" MaxHeight="180" CornerRadius="8"
                             FontFamily="Consolas, Cascadia Mono, Segoe UI Mono"
                             PlaceholderText="SELECT * FROM users LIMIT 100;"/>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10">
                        <Button Content="Run" Click="Run_Click" Style="{StaticResource PillButton}"/>
                        <Button Content="Show tables" Click="ShowTables_Click" CornerRadius="16"/>
                        <TextBlock x:Name="ResultInfo" VerticalAlignment="Center" Opacity="0.6" FontSize="12"/>
                    </StackPanel>

                    <Border Grid.Row="3" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <TextBlock x:Name="EmptyMsg" Text="Select a database on the left, then pick a table or run a query."
                                       Opacity="0.55" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Padding="30"/>
                            <TextBlock x:Name="ErrorMsg" Foreground="{StaticResource BhErrorBrush}"
                                       TextWrapping="Wrap" Padding="16" Visibility="Collapsed"
                                       FontFamily="Consolas, Cascadia Mono, Segoe UI Mono"/>
                            <ScrollViewer x:Name="ResultScroll" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                                <Grid x:Name="ResultGrid" Padding="0" Background="Transparent"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
