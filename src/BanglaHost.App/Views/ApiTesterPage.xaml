<Page x:Class="BanglaHost.App.Views.ApiTesterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:BanglaHost.App.Views">

    <Grid Padding="28,24,28,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
            <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource BhCacheAccent}">
                <FontIcon Glyph="&#xE968;" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="API Tester" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Text="Send HTTP requests to any endpoint — local or public. Postman-lite, built in." Style="{StaticResource PageSubtitleStyle}"/>
            </StackPanel>
        </StackPanel>

        <!-- Request bar -->
        <Border Grid.Row="1" Style="{StaticResource PremiumCard}" Padding="14,12">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0" x:Name="MethodBox" CornerRadius="8" HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="GET" IsSelected="True"/>
                    <ComboBoxItem Content="POST"/>
                    <ComboBoxItem Content="PUT"/>
                    <ComboBoxItem Content="PATCH"/>
                    <ComboBoxItem Content="DELETE"/>
                    <ComboBoxItem Content="HEAD"/>
                    <ComboBoxItem Content="OPTIONS"/>
                </ComboBox>
                <TextBox Grid.Column="1" x:Name="UrlBox" CornerRadius="8"
                         PlaceholderText="https://api.example.com/users  —  or  http://myapp.test/api/ping"
                         FontFamily="Consolas, Cascadia Mono, Segoe UI Mono"/>
                <Button Grid.Column="2" Content="Send" Click="Send_Click" Style="{StaticResource PillButton}"/>
                <Button Grid.Column="3" x:Name="CancelBtn" Content="Cancel" Click="Cancel_Click" CornerRadius="16" IsEnabled="False"/>
            </Grid>
        </Border>

        <!-- Status bar -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="16" Margin="4,0,0,0">
            <ProgressRing x:Name="Busy" IsActive="False" Width="20" Height="20"/>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <TextBlock x:Name="TimingText" VerticalAlignment="Center" Opacity="0.65"/>
            <TextBlock x:Name="SizeText"   VerticalAlignment="Center" Opacity="0.65"/>
        </StackPanel>

        <!-- Request / Response split -->
        <Grid Grid.Row="3" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Request -->
            <Border Grid.Column="0" Style="{StaticResource PremiumCard}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Request" Style="{StaticResource CardTitleStyle}" Padding="16,14,16,4"/>
                    <Pivot Grid.Row="1" Margin="8,0,8,8">
                        <PivotItem Header="Headers">
                            <Grid RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="One per line — Key: Value" Opacity="0.6" FontSize="12"/>
                                <TextBox Grid.Row="1" x:Name="HeadersBox" AcceptsReturn="True" TextWrapping="NoWrap"
                                         FontFamily="Consolas, Cascadia Mono, Segoe UI Mono" CornerRadius="8"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         PlaceholderText="Accept: application/json&#x0a;Authorization: Bearer …"/>
                            </Grid>
                        </PivotItem>
                        <PivotItem Header="Body">
                            <Grid RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10">
                                    <ComboBox x:Name="BodyTypeBox" CornerRadius="8" SelectionChanged="BodyType_Changed">
                                        <ComboBoxItem Content="None" IsSelected="True"/>
                                        <ComboBoxItem Content="JSON"/>
                                        <ComboBoxItem Content="Form URL-encoded"/>
                                        <ComboBoxItem Content="Raw text"/>
                                    </ComboBox>
                                    <Button Content="Format JSON" Click="FormatJson_Click" CornerRadius="16"/>
                                </StackPanel>
                                <TextBox Grid.Row="1" x:Name="BodyBox" AcceptsReturn="True" TextWrapping="NoWrap"
                                         FontFamily="Consolas, Cascadia Mono, Segoe UI Mono" CornerRadius="8"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         PlaceholderText="{}{ &quot;name&quot;: &quot;test&quot; }"/>
                            </Grid>
                        </PivotItem>
                        <PivotItem Header="Auth">
                            <Grid RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <ComboBox Grid.Row="0" x:Name="AuthBox" CornerRadius="8" SelectionChanged="Auth_Changed">
                                    <ComboBoxItem Content="None" IsSelected="True"/>
                                    <ComboBoxItem Content="Bearer token"/>
                                    <ComboBoxItem Content="Basic (user + pass)"/>
                                </ComboBox>
                                <TextBox Grid.Row="1" x:Name="AuthField1" CornerRadius="8" PlaceholderText="token" Visibility="Collapsed"/>
                                <TextBox Grid.Row="2" x:Name="AuthField2" CornerRadius="8" PlaceholderText="password" Visibility="Collapsed"/>
                                <TextBlock Grid.Row="3" Opacity="0.55" FontSize="12" TextWrapping="Wrap"
                                           Text="Auth values are added to the request headers automatically."/>
                            </Grid>
                        </PivotItem>
                    </Pivot>
                </Grid>
            </Border>

            <!-- Response -->
            <Border Grid.Column="1" Style="{StaticResource PremiumCard}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Padding="16,14,16,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Response" Style="{StaticResource CardTitleStyle}"/>
                        <Button Grid.Column="1" Content="Copy" Click="CopyResp_Click" CornerRadius="14" Padding="10,4"/>
                    </Grid>
                    <Pivot Grid.Row="1" Margin="8,0,8,8">
                        <PivotItem Header="Body">
                            <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="RespBody" TextWrapping="NoWrap" IsTextSelectionEnabled="True"
                                           FontFamily="Consolas, Cascadia Mono, Segoe UI Mono" Padding="8"
                                           Text="Send a request to see the response here."/>
                            </ScrollViewer>
                        </PivotItem>
                        <PivotItem Header="Headers">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="RespHeaders" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                           FontFamily="Consolas, Cascadia Mono, Segoe UI Mono" Padding="8"/>
                            </ScrollViewer>
                        </PivotItem>
                    </Pivot>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
