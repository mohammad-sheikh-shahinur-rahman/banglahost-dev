<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BanglaHost.App.Views.EnvManagerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="28,24,28,28" Spacing="18">
            <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border Width="36" Height="36" CornerRadius="10">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#FF0D9488" Offset="0"/>
                                <GradientStop Color="#FF14B8A6" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <FontIcon Glyph="&#xE731;" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Environment Variables" Style="{StaticResource PageTitleStyle}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Manage .env files for your sites easily."
                           Style="{StaticResource PageSubtitleStyle}" Margin="48,0,0,0"/>
            </StackPanel>

            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="12">
                    <TextBlock Text="Select Site" FontWeight="SemiBold"/>
                    <Border Style="{StaticResource ListCard}" MinHeight="400">
                        <ListView x:Name="SiteList" SelectionChanged="SiteList_SelectionChanged">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Grid Padding="14,12" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                                        <TextBlock Text="{x:Bind}" FontWeight="SemiBold"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <TextBlock Text="Environment File (.env)" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Content="Save" Click="SaveBtn_Click" Style="{StaticResource PillButton}" Background="{StaticResource BhBrandBrush}" Foreground="White"/>
                        <TextBlock x:Name="StatusLabel" Style="{StaticResource LabelStyle}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Border Style="{StaticResource PremiumCard}" MinHeight="400">
                        <TextBox x:Name="EnvEditor" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="14"
                                 BorderThickness="0" Background="Transparent" VerticalAlignment="Stretch"/>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
