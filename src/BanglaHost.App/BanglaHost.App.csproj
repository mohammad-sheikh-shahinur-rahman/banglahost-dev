<Project Sdk="Microsoft.NET.Sdk">
  <!-- WinUI 3, UNPACKAGED (WindowsPackageType=None) â€” so the app can spawn server
       processes and (via the elevate helper) edit the hosts file. MSIX would sandbox
       those away. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>BanglaHost.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType Condition="'$(BuildMsix)' != 'true'">None</WindowsPackageType>
    <WindowsPackageType Condition="'$(BuildMsix)' == 'true'">MSIX</WindowsPackageType>
    <WindowsAppSDKSelfContained Condition="'$(RuntimeIdentifier)' != ''">true</WindowsAppSDKSelfContained>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <Version>1.6.4.2</Version>
    <Company>IT Amadersomaj Inc</Company>
    <Product>BanglaHost Local Web Server</Product>
    <Description>BanglaHost Local Web Server</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.241114003" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
    <!-- NOTE 2026-09-05: WinAppSDK 1.8.260804001 (latest 1.x) verified on nuget.org but this
         machine's link (~29 KB/s) cannot pull the ~500MB+ closure; parked until network allows.
         2.x is a new major — stays out of scope (needs migration review). -->
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\BanglaHost.Core\BanglaHost.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\AppIcon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\banglaHost.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\logo.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup><PackageReference Include="System.Security.Permissions" Version="8.0.0" /></ItemGroup></Project>







