<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="BanglaHost.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    Title="BanglaHost">

    <Grid>
        <muxc:NavigationView x:Name="Nav"
                             PaneDisplayMode="Left"
                             OpenPaneLength="250"
                             IsBackButtonVisible="Collapsed"
                             IsSettingsVisible="True"
                             AlwaysShowHeader="False"
                             SelectionChanged="Nav_SelectionChanged"
                             Loaded="Nav_Loaded">

            <!-- Pane header: app logo + product name -->
            <muxc:NavigationView.PaneHeader>
                <StackPanel Orientation="Horizontal" Spacing="12" Padding="14,14,14,10">
                    <Border Width="36" Height="36" CornerRadius="10">
                        <Border.Background>
                            <ImageBrush ImageSource="Assets/logo.png" Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="0">
                        <TextBlock Text="BanglaHost" FontWeight="Bold" FontSize="15"/>
                        <Border Background="{StaticResource BhGradientHorizontal}" CornerRadius="8" Padding="8,2" Margin="0,3,0,0"
                                HorizontalAlignment="Left">
                            <TextBlock x:Name="VersionLabel" Text="local web stack" FontSize="10" Foreground="White" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </muxc:NavigationView.PaneHeader>

            <!-- Sidebar search box -->
            <muxc:NavigationView.AutoSuggestBox>
                <AutoSuggestBox x:Name="NavSearch" PlaceholderText="Search…" QueryIcon="Find"
                                TextChanged="NavSearch_TextChanged" SuggestionChosen="NavSearch_SuggestionChosen"/>
            </muxc:NavigationView.AutoSuggestBox>

            <muxc:NavigationView.MenuItems>
                <muxc:NavigationViewItemHeader Content="Overview"/>
                <muxc:NavigationViewItem Content="Dashboard" Tag="dashboard">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xEA8A;"/></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Services"  Tag="services">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE912;"/></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Sites"     Tag="sites" Icon="World"/>
                <muxc:NavigationViewItem Content="Databases" Tag="databases">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xEE94;"/></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItemHeader Content="Develop"/>
                <muxc:NavigationViewItem Content="Terminal"  Tag="terminal">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE756;"/></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Files"     Tag="files" Icon="Folder"/>
                <muxc:NavigationViewItem Content="Git"       Tag="git">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE8AD;"/></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Database Explorer" Tag="explorer">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE8FD;"/></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItemHeader Content="Runtimes"/>
                <muxc:NavigationViewItem Content="Node"      Tag="node">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE7B8;"/></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Python"    Tag="python">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE943;"/></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="PHP Extensions" Tag="php_ext">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE9F5;"/></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="PHP INI Manager" Tag="php_ini">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE81E;"/></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItemHeader Content="Automation"/>
                <muxc:NavigationViewItem Content="SSL"       Tag="ssl">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE72E;"/></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Domains"   Tag="domains">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE774;"/></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Deploy"    Tag="deploy">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE898;"/></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Backup"    Tag="backup">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE895;"/></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Scheduler" Tag="scheduler" Icon="Calendar"/>
                <muxc:NavigationViewItem Content="Security"  Tag="security">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xEA18;"/></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItemHeader Content="Monitoring"/>
                <muxc:NavigationViewItem Content="Network"   Tag="network">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE968;"/></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Cache"     Tag="cache">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE946;"/></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Queue"     Tag="queue">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE756;"/></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Email"     Tag="email">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE715;"/></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Docker"    Tag="docker">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE7F8;"/></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="VS Code"   Tag="vscode">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE8A5;"/></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="GitHub Actions" Tag="github_actions">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE78B;"/></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Cloudflare Tunnel" Tag="cf_tunnel">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE72D;"/></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItemHeader Content="Explore"/>
                <muxc:NavigationViewItem Content="AI Assistant" Tag="ai">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE99A;"/></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Marketplace"  Tag="marketplace" Icon="Shop"/>
                <muxc:NavigationViewItem Content="Blueprint"    Tag="blueprint">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE70F;"/></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItemHeader Content="Diagnostics"/>
                <muxc:NavigationViewItem Content="Site Health" Tag="site_health">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE9A1;"/></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Log Watcher" Tag="file_watcher">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE71C;"/></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Logs"      Tag="logs" Icon="Memo"/>

                <muxc:NavigationViewItemHeader Content="Tools"/>
                <muxc:NavigationViewItem Content="API Tester" Tag="api_tester">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE968;"/></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Reverse Proxy" Tag="reverse_proxy">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE8B1;"/></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content=".env Manager" Tag="env_manager">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE731;"/></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Package Manager" Tag="package_manager">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE7B8;"/></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Project Analyzer" Tag="project_analyzer">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE943;"/></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItemHeader Content="Support"/>
                <muxc:NavigationViewItem Content="About BanglaHost" Tag="about">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE946;"/></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Contact Support" Tag="support_email">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE715;"/></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Report Bug" Tag="support_bug">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xEBE8;"/></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Request Feature" Tag="support_feature">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xEA80;"/></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Documentation" Tag="support_docs">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE8A5;"/></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Donate" Tag="support_donate">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE8B0;"/></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
            </muxc:NavigationView.MenuItems>



            <Frame x:Name="ContentFrame"/>
        </muxc:NavigationView>
    </Grid>
</Window>
